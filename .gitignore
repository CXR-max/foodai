/models/
tools/*.zip
# 可执行文件与压缩包：历史里已有 cloudflared.exe / foodai_new.zip（13MB+），
# 这里只防止以后再提交同类大二进制（已进历史的文件 .gitignore 删不掉）
tools/*.exe
*.zip
# llama.cpp 本地推理程序与 GGUF 模型（656MB，不入库）
/tools/llama/

# 营养数据源与导入报告（许可见 README，不提交原始数据）

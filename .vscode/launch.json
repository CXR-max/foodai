{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}\\backend",
      "python": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "env": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}

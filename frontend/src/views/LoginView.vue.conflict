  } finally {
    loading.value = false
  }
}

/** 点人脸登录：先确认这个账号绑过脸，再唤起摄像头 */
async function openFace() {
  if (!form.username.trim()) {
    ElMessage.warning('请先输入用户名，再刷脸登录')
    return
  }
  faceLoading.value = true
  try {
    const s = await faceApi.faceStatus(form.username.trim())
    faceMock.value = s.mock
    if (!s.registered) {
      ElMessage.warning('该账号还没绑定人脸，请先用密码登录，到「我的」里绑定')
      return
    }
    faceVisible.value = true
  } catch {
    /* http.ts 已经统一提示过错误 */
  } finally {
    faceLoading.value = false
  }
}

/** 拿到现场照 → 1:1 比对 → ticket → 换 token */
async function onFaceCaptured(images: string[]) {
  faceLoading.value = true
  try {
    const { ticket } = await faceApi.faceVerify(form.username.trim(), images)
    const data = await faceApi.faceLogin(ticket)
    auth.setSession(data.token, data.user)
    ElMessage.success('刷脸登录成功')
    window.location.replace('/dashboard')
  } catch {
    /* 错误提示已统一处理 */
  } finally {
    faceLoading.value = false
  }
}
</script>

<template>
  <div class="auth-page" :class="{ 'is-mobile': isMobile }">
    <el-card class="auth-card" :body-style="{ padding: isMobile ? '22px 18px' : '20px 24px' }">
      <h2 class="auth-title">🥗 识膳智行</h2>
      <p class="auth-sub">AI 健康管理平台 · 爱吃才是最好的营养师</p>

      <el-form
        ref="formRef"
        :model="form"
        :rules="rules"
        size="large"
        @submit.prevent="submit"
        @keyup.enter.prevent="submit"
      >
        <el-form-item prop="username">
          <el-input v-model="form.username" placeholder="用户名" autocomplete="username" />
        </el-form-item>
        <el-form-item prop="password">
          <el-input
            v-model="form.password"
            type="password"
            show-password
            placeholder="密码"
            autocomplete="current-password"
          />
        </el-form-item>
        <el-button
          type="success"
          size="large"
          class="btn-block"
          native-type="button"
          :loading="loading"
          @click="submit"
        >
          登 录
        </el-button>
      </el-form>

      <el-divider class="auth-divider">或</el-divider>

      <el-button
        class="btn-block face-btn"
        size="large"
        :loading="faceLoading"
        @click="openFace"
      >
        <span class="face-icon">👤</span> 人脸登录
      </el-button>
      <p class="face-note">
        首次使用需先用密码登录，在「我的」里绑定人脸
        <el-tag v-if="faceMock" size="small" type="info" effect="plain" class="mock-tag">演示模式</el-tag>
      </p>

      <div class="auth-footer">
        还没有账号？<router-link to="/register">立即注册</router-link>
      </div>
    </el-card>

    <FaceCaptureDialog
      v-model:visible="faceVisible"
      title="人脸登录"
      :tip="faceMock ? '当前为演示模式，未做真实人脸比对' : ''"
      @captured="onFaceCaptured"
    />
  </div>
</template>


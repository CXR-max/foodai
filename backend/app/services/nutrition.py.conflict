"""
营养与身体指标计算服务（"视觉→营养"管线的枢纽）
- 身体指标：BMI / BMR(Mifflin-St Jeor) / 每日热量目标
- 识别→营养：菜名匹配营养库 → 按克重换算营养值（mock 与真模型共用同一管线）
"""
from app.services.llm import foods_data

# 活动系数（BMR → 每日总消耗 TDEE）
ACTIVITY_FACTORS = {
    "sedentary": 1.2,    # 久坐少动
    "light": 1.375,      # 轻度活动（每周运动1-3次）
    "moderate": 1.55,    # 中度活动（每周3-5次）
    "active": 1.725,     # 高度活动（每周6-7次）
    "athlete": 1.9,      # 运动员级/体力劳动
}


# ================= 身体指标 =================

def calc_bmi(weight_kg: float | None, height_cm: float | None) -> float | None:
    """BMI = 体重kg / 身高m²"""
    if not weight_kg or not height_cm or height_cm <= 0:
        return None
    return round(weight_kg / (height_cm / 100) ** 2, 1)


def bmi_level(bmi: float | None) -> str:
    """BMI 中国标准分级"""
    if bmi is None:
        return "未知"
    if bmi < 18.5:
        return "偏瘦"
    if bmi < 24:
        return "正常"
    if bmi < 28:
        return "超重"
    return "肥胖"


def calc_bmr(weight_kg, height_cm, age, gender) -> float | None:
    """基础代谢率（Mifflin-St Jeor 公式）：男 10W+6.25H-5A+5 / 女 -161"""
    if not (weight_kg and height_cm and age):
        return None
    bmr = 10 * weight_kg + 6.25 * height_cm - 5 * age
    bmr += 5 if gender == "male" else -161
    return round(bmr)


# 减脂赤字按 BMI 分档：(BMI 上限, 赤字比例)；BMI<18.5 不设赤字（劝阻）
DEFICIT_BANDS = ((28.0, 0.20), (24.0, 0.15), (0.0, 0.10))
# 体脂参考线（行业分级，只作提示触发，不作诊断）：男≥20%、女≥30% 视为偏高
BODY_FAT_HIGH = {"male": 20.0, "female": 30.0}
# 增肌盈余：常规 10%，超重（BMI≥28）收到 5%
SURPLUS_NORMAL = 0.10
SURPLUS_OVERWEIGHT = 0.05


def body_fat_high(body_fat_pct, gender) -> bool:
    """体脂是否偏高（参考线，不是诊断标准；WHO 判肥胖为男>25%、女>35%）"""
    try:
        value = float(body_fat_pct)
    except (TypeError, ValueError):
        return False
    if value <= 0:
        return False
    return value >= BODY_FAT_HIGH.get((gender or "").lower(), BODY_FAT_HIGH["male"])


def goal_adjustment(
    weight_kg, height_cm, goal: str = "maintain", body_fat_pct=None, gender=None
) -> dict:
    """诉求 → 热量策略（赤字/盈余百分比）

    这是全站唯一的口径：档案保存、方案生成、每日区间都从这里取，
    不按 BMI 一刀切——**诉求决定策略，BMI / 体脂只决定强度与劝阻**。
    """
    goal = (goal or "maintain").strip().lower()
    if goal not in ("lose", "maintain", "gain", "healthy"):
        goal = "maintain"
    bmi = calc_bmi(weight_kg, height_cm) or 0.0
    deficit = 0.0
    surplus = 0.0
    effective = goal

    if goal == "lose":
        if bmi and bmi < 18.5:
            effective = "maintain"          # 劝阻：低体重不减
        else:
            deficit = next(rate for ceil, rate in DEFICIT_BANDS if bmi >= ceil)
            if bmi < 24 and body_fat_high(body_fat_pct, gender):
                deficit = 0.15             # 体重正常但体脂偏高，强度提一档
    elif goal == "gain":
        surplus = SURPLUS_OVERWEIGHT if bmi >= 28 else SURPLUS_NORMAL
    # healthy / maintain：不设赤字，吃够 TDEE

    return {
        "bmi": round(bmi, 1) if bmi else None,
        "deficit_pct": round(deficit, 3),
        "surplus_pct": round(surplus, 3),
        "effective_goal": effective,
    }


def calc_daily_target(
    weight_kg, height_cm, age, gender, activity_level: str = "moderate", goal: str = "maintain",
    body_fat_pct=None,
) -> int | None:
    """每日热量目标 = TDEE × (1 − 赤字 + 盈余)

    下限取 BMR×1.1（低于基础代谢的减脂不可持续），再兜底 1200 kcal。
    """
    bmr = calc_bmr(weight_kg, height_cm, age, gender)
    if bmr is None:
        return None
    tdee = bmr * ACTIVITY_FACTORS.get(activity_level, 1.55)
    adj = goal_adjustment(weight_kg, height_cm, goal, body_fat_pct, gender)
    target = tdee * (1 - adj["deficit_pct"] + adj["surplus_pct"])
    target = max(target, bmr * 1.1)
    return max(int(round(target / 10.0) * 10), 1200)


# ================= 识别 → 营养换算 =================

# 份量档位系数：模型只判"相对常见一份的大小"，绝对克重用本地标准份量校准（误差可控）
SIZE_FACTORS = {"small": 0.7, "normal": 1.0, "large": 1.3}
# 未收录菜品：接受模型克重，但限制在合理区间（防离谱幻觉）
PORTION_CLAMP = (50, 1500)


def resolve_portion(dish_name: str, model_portion_g: float, size_class: str = "normal") -> float:
    """档位制克数校准：命中营养库 → 标准份 × 档位系数（限 ±50%）；未命中 → 模型克重 clamp"""
    entry = foods_data.find_food(dish_name)
    if entry and entry.get("common_portion_g"):
        base = float(entry["common_portion_g"])
        factor = SIZE_FACTORS.get((size_class or "").strip().lower(), 1.0)
        g = min(max(base * factor, base * 0.5), base * 1.6)
        return round(g)
    lo, hi = PORTION_CLAMP
    return round(min(max(model_portion_g or 0, lo), hi))


def match_and_calc(dish_name: str, portion_g: float, category: str | None = None) -> dict:
    """
    菜名 + 克重 → 匹配营养库 → 营养值
    命中库：营养值精确且全站口径一致；未命中：按类别均值估算（类别不识别则全库均值）并标记
    返回：{calories, protein_g, fat_g, carb_g, matched, matched_name, match_method, match_score,
           nutrition_source, note}
    """
    match = foods_data.match_entry(dish_name)
    if match:
        entry = match["entry"]
        nut = foods_data.calc_nutrition(entry, portion_g)
        return {
            **nut,
            "matched": True,
            "matched_name": entry["name"],
            "match_method": match["method"],
            "match_score": match["score"],
            "nutrition_source": "dish_library",
            "note": foods_data.describe_match(match),
        }
    # 未收录 → 类别均值（category_average 内部对未知类别自动回退全库均值）× 克重
    avg = foods_data.category_average(category or None)
    factor = max(portion_g, 0) / 100.0
    return {
        "calories": round(avg["calories"] * factor, 1),
        "protein_g": round(avg["protein_g"] * factor, 1),
        "fat_g": round(avg["fat_g"] * factor, 1),
        "carb_g": round(avg["carb_g"] * factor, 1),
        "matched": False,
        "matched_name": None,
        "match_method": "none",
        "match_score": 0.0,
        "nutrition_source": "category_average",
        "note": "菜品暂未收录营养库，按通用估算值记录",
    }


def match_diet_nutrition(dish_name: str, portion_g: float, category: str | None = None) -> dict:
    """菜名 + 克重 → 七项营养（与排餐器同一套换算，供方案自检用）

    命中营养库用库值（纤维/钠/糖缺失按同类中位数补）；未命中按类目均值估算。
    """
    match = foods_data.match_entry(dish_name)
    if match:
        return foods_data.calc_diet_nutrients(match["entry"], portion_g)
    avg = foods_data.category_average_diet(category or None)
    factor = max(portion_g, 0) / 100.0
    return {key: round(value * factor, 1) for key, value in avg.items()}
